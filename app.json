        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.orion1234.Framez"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f507a498-0bdb-4b7b-b369-b971d1eb3843"
      }
    },
    "owner": "orion-1234",
    "plugins": [
      "expo-font"
    ]
  }
}
